PRIVATE_LANE_URL=YOUR_PRIVATE_LANE_URL_HERE
PRIVATE_LANE_TOKEN=YOUR_PRIVATE_LANE_TOKEN_HERE
# The 14B review-only lane (ReviewLLM endpoint). Reuses PRIVATE_LANE_TOKEN, so only the URL is new.
REVIEW_LANE_URL=YOUR_REVIEW_LANE_URL_HERE
# Toggle the 14B compliance review. "on" (default) runs it; "off" skips it to save GPU cost during dev.
REVIEW_LLM=on