PRIVATE_LANE_URL=YOUR_PRIVATE_LANE_URL_HERE
PRIVATE_LANE_TOKEN=YOUR_PRIVATE_LANE_TOKEN_HERE

# The 14B review-only lane (ReviewLLM endpoint). Reuses PRIVATE_LANE_TOKEN, so only the URL is new.
REVIEW_LANE_URL=YOUR_REVIEW_LANE_URL_HERE

# Universal model toggle: dev (all 3B, cheap) | local (3B + 14B on Modal) | full (adds Claude cloud). Default dev.
MODEL_TIER=dev

# Agent mode toggle: deterministic (fixed LangGraph pipeline) | autonomous (5 ReAct agents + orchestrator). Default deterministic.
AGENT_MODE=deterministic
# Only needed when MODEL_TIER=full (the cloud lane calls Claude). Leave blank otherwise.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

#POSTGRESQL DATBASE URL
DATABASE_URL=postgresql://user:password@localhost:port/DBname

#Email variables
EMAIL_USER=NimbusSupportDesk@gmail.com
EMAIL_PASSWORD=abcdefghijklmnop
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

AUTH_SECRET=change-me-to-a-long-random-string

# Which origins the browser may call this API from. Comma separated, exact origin,
# NO trailing slash. Deployed, this is the front end's URL.
CORS_ORIGINS=http://localhost:3000

# Local dev: leave these as they are. DEPLOYED, where the front end and the API sit on
# different domains, set COOKIE_SECURE=true and COOKIE_SAMESITE=none, or the session
# cookie is silently dropped and login appears to do nothing.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# The client's branding. BRAND_NAME repaints the portal AND names the support team
# every reply is signed with. BRAND_SIGNOFF overrides that wording outright; leave it
# blank and it is derived as "The <BRAND_NAME> Support Team".
BRAND_NAME=Nimbus
BRAND_TAGLINE=Support that answers
BRAND_SIGNOFF=

JIRA_BASE_URL=https://nimbus-support.atlassian.net
JIRA_EMAIL=your-atlassian-login@gmail.com
JIRA_PROJECT_KEY=SUP
JIRA_API_TOKEN=paste-the-token-here 


